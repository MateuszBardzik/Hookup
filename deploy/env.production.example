# Settings of the LIVE site (server-setup.sh copies this to back-end/.env on the server
# and fills in the domain and a random secret key). Edit on the server: nano back-end/.env
# then run:  systemctl restart engivexlab

DJANGO_SECRET_KEY=__SECRET__
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=__DOMAIN__,www.__DOMAIN__
DJANGO_CSRF_TRUSTED_ORIGINS=https://__DOMAIN__,https://www.__DOMAIN__
DJANGO_HTTPS=true

# Address of the website (used in verification e-mail links)
FRONTEND_URL=https://__DOMAIN__
SITE_NAME=engivexlab

# E-mail (sign-up verification) via the Mailgun HTTP API.
# Empty = e-mails are only written to the log (journalctl -u engivexlab).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# EU-region Mailgun account:
# MAILGUN_API_URL=https://api.eu.mailgun.net
# DEFAULT_FROM_EMAIL=engivexlab <no-reply@__DOMAIN__>

# Google / Apple login (optional; also add https://__DOMAIN__ in the Google / Apple consoles)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
