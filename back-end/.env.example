# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is ignored by git, so your secrets stay on your machine.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Address of the website (used by the "View site" link on the admin pages)
FRONTEND_URL=http://localhost:5173

# Sending email (sign-up verification links).
# Leave everything below empty during development: emails are printed in the runserver terminal instead.
#
# Option 1 (recommended) - Mailgun HTTP API. Uses HTTPS, so it works even where SMTP ports are blocked.
#   MAILGUN_API_KEY: Mailgun dashboard > API keys (a "Private API key" / "Sending key")
#   MAILGUN_DOMAIN:  your sending domain, e.g. mg.yourcompany.com
#   EU-region domain? also set MAILGUN_API_URL=https://api.eu.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# MAILGUN_API_URL=https://api.eu.mailgun.net
#
# Option 2 - any SMTP server (used only when MAILGUN_API_KEY is empty), e.g. Gmail with an "App password":
#   EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587  EMAIL_USE_TLS=true
#   EMAIL_HOST_USER=you@gmail.com  EMAIL_HOST_PASSWORD=<16-character app password>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Sender shown in the email (default: Hookup <no-reply@MAILGUN_DOMAIN> or Hookup <EMAIL_HOST_USER>).
# DEFAULT_FROM_EMAIL=Hookup <no-reply@mg.yourcompany.com>

# Google login: create an "OAuth client ID" (type: Web application) at
# https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 to "Authorized JavaScript origins".
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Apple login: needs an Apple Developer account. Create a "Services ID" and
# enable "Sign in with Apple". Apple does NOT accept localhost; use a real
# HTTPS domain. Leave empty to hide the Apple button.
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
# Replies to support emails written on the admin pages go to this address:
# SUPPORT_EMAIL=support@engivexlab.com
